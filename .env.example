# Skopíruj tento súbor ako ".env.local" a doplň skutočné hodnoty pre klienta.
# Detaily a návod nájdeš v README.md a v src/config.ts.

# URL Google Sheets tabuľky s menu, exportovaná ako CSV.
# Súbor → Zdieľať → Publikovať na web → vyber hárok → formát .csv
# Ak necháš prázdne, Menu sekcia zobrazí predpripravené ukážkové dáta.
MENU_SHEET_CSV_URL=

# API kľúč pre Resend (https://resend.com) — slúži na odosielanie správ
# z kontaktného formulára. Bezplatný plán stačí na základné fungovanie.
# Ak necháš prázdne, formulár automaticky použije "mailto:" odkaz ako zálohu.
RESEND_API_KEY=
